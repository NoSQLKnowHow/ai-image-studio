# Settings for compose.yaml. Copy to .env and edit; .env is not committed (it can hold a token).
# A missing or empty value uses the default shown.

# --- Who the container runs as: your own user, so ./data and the model cache stay yours.
# Find yours with:  id -u   and   id -g
STUDIO_UID=1000
STUDIO_GID=1000

# --- Where it listens. 0.0.0.0 = reachable from your LAN at http://<spark-address>:8080.
# 127.0.0.1 = only on the Spark itself (use an SSH tunnel or an NVIDIA Sync custom app).
STUDIO_BIND=0.0.0.0
STUDIO_PORT=8080

# Optional DNS-rebinding guard: the host names/addresses you browse to, comma-separated,
# e.g. spark-1a2b.local,192.168.1.20  (localhost always works). Empty = accept any.
STUDIO_ALLOWED_HOSTS=

# --- Model
STUDIO_MODEL=Qwen/Qwen-Image-2.1
# Hugging Face cache folder on the Spark (default: ~/.cache/huggingface, the usual shared one).
# HF_CACHE_DIR=/home/you/.cache/huggingface
# Only needed if the model repo is gated or private.
HF_TOKEN=
# true = never contact Hugging Face; the model must already be in the cache.
STUDIO_LOCAL_FILES_ONLY=false

# --- Memory (the Spark's 128 GB is shared by the CPU, the GPU and everything else, Hermes included)
# Refuse to load the model unless at least this many GB are free (MemAvailable). 40 is an estimate,
# to be replaced by the number you measure (docs/SPARK_TEST.md). 0 = no check.
STUDIO_MIN_FREE_GB=40
# Unload the model after this many idle minutes, to give the memory back. 0 = right away.
STUDIO_IDLE_TIMEOUT_MIN=15
# true = keep parts of the model in CPU memory between uses (slower; rarely useful on the Spark).
STUDIO_CPU_OFFLOAD=false

# --- History
STUDIO_QUEUE_CAP=10
# Delete runs older than this many days; 0 = keep everything. NOT ACTIVE YET: auto-expiry is part of
# version 2 (milestone M6). Until then nothing is deleted unless you delete it.
STUDIO_RETENTION_DAYS=30

# --- Build: NVIDIA PyTorch release (nvcr.io/nvidia/pytorch:<tag>). 25.10 or newer for the Spark.
NGC_TAG=25.10-py3
